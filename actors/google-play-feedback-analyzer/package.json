{
    "name": "google-play-feedback-analyzer",
    "version": "0.1.0",
    "type": "module",
    "description": "Collect public Google Play review records for later feedback analysis.",
    "engines": {
        "node": ">=18.0.0"
    },
    "dependencies": {
        "apify": "^3.7.0",
        "cheerio": "^1.0.0-rc.12",
        "@project/feedback-analysis-core": "file:vendor/project-feedback-analysis-core-1.0.0.tgz"
    },
    "devDependencies": {
        "@apify/eslint-config": "^2.0.0",
        "eslint": "^9.29.0",
        "eslint-config-prettier": "^10.1.5",
        "prettier": "^3.5.3",
        "vitest": "^4.1.0"
    },
    "scripts": {
        "start": "node ./src/main.js",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "test": "node --test test/*.test.mjs tests/technical-spike-fixtures.test.mjs",
        "validate:schema": "apify validate-schema"
    },
