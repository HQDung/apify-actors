{
  "name": "steam-game-feedback-analyzer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Collect public Steam reviews and turn player feedback into structured game insights.",
  "dependencies": {
    "apify": "^3.7.0"
  },
  "devDependencies": {
    "@apify/eslint-config": "^2.0.0",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "prettier": "^3.5.3",
    "vitest": "^4.1.0"
  },
  "scripts": {
    "start": "node src/main.js",
    "build": "node --check src/main.js",
    "lint": "eslint",
    "test": "vitest run",
    "format:check": "prettier --check .",
    "validate:schema": "apify validate-schema",
    "validate:release": "node scripts/validate-release.mjs ."
  }
}
